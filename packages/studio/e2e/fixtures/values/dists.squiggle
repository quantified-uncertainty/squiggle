// Distributions of every kind.

@name("Normal")
normalDist = normal(10, 2)

@name("Lognormal (5 to 50)")
lognormalDist = 5 to 50

@name("Uniform")
uniformDist = uniform(0, 1)

@name("Beta")
betaDist = beta(2, 5)

@name("Triangular")
triangularDist = triangular(1, 2, 4)

@name("Point mass")
pointMassDist = pointMass(3)

@name("Discrete mixture of numbers")
discreteDist = mx(1, 2, 3, [0.2, 0.5, 0.3])

@name("Mixture of continuous dists")
mixtureDist = mx(normal(0, 1), normal(5, 1), [0.3, 0.7])

@name("Sample set")
sampleSetDist = SampleSet.fromDist(normal(100, 15))

@name("Point set")
pointSetDist = PointSet.fromDist(normal(0, 1))

@name("Mixed discrete and continuous")
mixedDist = mx(pointMass(0), 1 to 10, [0.4, 0.6])

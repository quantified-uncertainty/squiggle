// Function cards (QA #26).

@doc("Cost of x widgets")
oneNumber(x) = x * 2 + 1

@name("Domain-limited function")
rangeFn(x: [1, 10]) = x ^ 2

multiArg(a, b) = a + b

@doc("Converts an annual amount to a monthly one.")
toMonthly(x) = x / 12

@name("Expected cost of a very long-named intervention over the years")
@doc("A function with a long @name.")
longNamedCost(years) = years * (1k to 2k)

// Imports a public model from Squiggle Hub (needs network access).
// Source: https://squigglehub.org/models/quri/exports-example

import "hub:quri/exports-example" as example

@name("Hub variable a, scaled")
scaled = example.a * 10

@name("Sum of Hub list b")
total = List.reduce(example.b, 0, {|acc, x| acc + x})

{
  "name": "@quri/squiggle-studio",
  "version": "0.1.0",
  "description": "A local, browser-first editor and viewer for .squiggle files",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantified-uncertainty/squiggle.git",
    "directory": "packages/studio"
  },
  "author": "Quantified Uncertainty Research Institute",
  "type": "module",
  "bin": {
    "squiggle-studio": "./bin/squiggle-studio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts examples --dev",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "tsc -b",
    "build:client": "vite build",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "start": "node ./bin/squiggle-studio.js examples",
    "test": "vitest run",
    "e2e": "vite build && tsx e2e/run.ts",
    "e2e:shoot": "vite build && tsx e2e/shoot.ts",
    "e2e:serve": "vite build && tsx e2e/serve.ts",
    "e2e:golden": "vite build && tsx e2e/run.ts --update parity",
    "lint": "prettier --check . && pnpm run typecheck:client && pnpm run typecheck:e2e",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@quri/squiggle-lang": "workspace:*",
    "@quri/squiggle-relative-values": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@floating-ui/react": "^0.27.6",
    "@quri/configs": "workspace:*",
    "@quri/squiggle-components": "workspace:*",
    "@quri/ui": "workspace:*",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.3",
    "typescript": "5.8.2",
    "vite": "^6.2.4",
    "vitest": "^3.1.1"
  },
  "optionalDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
